PUBLIC_API_URL=http://localhost:8080

# Both organizations are created with this owner address and verified with the code emailed to it —
# an organization cannot send tasks to another one until a human has proved they own it.
OWNER_EMAIL=

# Stored in each scheduler's vault, one lease/redeem per call — the point of using the vault here
# is that this key never sits in memory longer than a single OpenAI call needs it.
OPENAI_API_KEY=
