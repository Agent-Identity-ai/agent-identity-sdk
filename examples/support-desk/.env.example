# The running agent-identity API this example talks to — nothing here reaches into the
# platform's own internals, this app is a plain @aid/sdk consumer like any real customer.
PUBLIC_API_URL=http://localhost:8080

# Only needed once, for `pnpm bootstrap` — mints everything else (identities, agent-scoped API
# keys, vault keypairs) and writes it to .state.json, which every other script then reads.
# Get one via `aid org create` or the dashboard's org bootstrap flow.
ADMIN_API_KEY=

# Stored in the vault (never in this file, never in .state.json) — `pnpm bootstrap` creates one
# vault secret per agent identity holding this key, and each long-running process leases/redeems
# its own copy at call time rather than reading this env var directly.
OPENAI_API_KEY=

# The frontdesk mailbox's local part — support@<MAIL_DOMAIN>.
FRONTDESK_HANDLE=support

# The domain verified with the mail provider, matching MAIL_PROVIDER_CONFIG.domain on the API.
# Mailboxes are provisioned under it, so this has to be the same domain the API sends from.
MAIL_DOMAIN=
